%% Conceptual methodological flow for Fig. "fig:flow" in access.tex
%% Convert to PNG (single-column width, >=300 dpi). Suggested:
%%   mmdc -i fig_flujo_conceptual.mmd -o fig_flujo_conceptual.png -s 3 -b white
%% (mmdc = @mermaid-js/mermaid-cli;  -s 3 ~ 3x scale for print resolution)
%% or paste into https://mermaid.live and export PNG.
flowchart LR
    A["RC analytical model<br/>H(s)=1/cosh(&#8730;(s&middot;R<sub>t</sub>C<sub>t</sub>))"]
    B["RC ladder N=5<br/>state-space"]
    C["FR-4 / Megtron 6<br/>RLGC dispersive channel<br/>R(f) skin, G(f) dielectric"]
    D["FFE / CTLE / DFE<br/>co-design by DoE-LHS<br/>input-referred noise"]
    E["BER + viable rate<br/>(rate-reach metric)"]
    F["Cross-validation<br/>LTspice + Touchstone S-params"]
    G["Open, traceable<br/>GitHub / Zenodo artifact"]
    A --> B --> C --> D --> E --> F --> G
    classDef model fill:#eaf2ff,stroke:#2b6cb0,color:#1a365d;
    classDef eval fill:#eafff0,stroke:#2f855a,color:#1c4532;
    classDef repro fill:#fff5ea,stroke:#c05621,color:#652b19;
    class A,B,C model;
    class D,E eval;
    class F,G repro;
