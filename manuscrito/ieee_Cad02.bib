@ARTICLE{10260232,
  author={Zhang, Bo and Vasani, Anand and Sinha, Ashutosh and Nilchi, Alireza and Tong, Haitao and Rao, Lakshmi P. and Khanoyan, Karapet and Hatamkhani, Hamid and Yang, Xiaochen and Meng, Xin and Wong, Alexander and Kim, Jun and Jing, Ping and Sun, Yehui and Nazemi, Ali and Liu, Dean and Brewster, Anthony and Cao, Jun and Momtaz, Afshin},
  journal={IEEE Journal of Solid-State Circuits}, 
  title={A 112-Gb/s Serial Link Transceiver With Three-Tap FFE and 18-Tap DFE Receiver for up to 43-dB Insertion Loss Channel in 7-nm FinFET Technology}, 
  year={2024},
  volume={59},
  number={1},
  pages={8-18},
  abstract={This article presents a power- and area-efficient multistandard serial link transceiver designed for application rates of up to 112 Gb/s, such as OIF CEI-112G and IEEE 802.3ck 400GBASE. The receiver features a continuous time linear equalizer, a programmable gain amplifier (PGA), a three-tap sampling-based feed-forward equalizer, and an 18-tap decision feedback equalizer. The transmitter uses a half-rate 2:1 multiplexer (MUX) with a duty cycle distortion corrected clock and a 7-bit digital to analog converter (DAC)-based driver with a six-tap feed-forward equalizer. The shared phase-locked loop (PLL) has a tuning range of 40–60 GHz with 0.12-ps rms jitter in integer mode and 0.16-ps jitter in fractional- ${N}$  mode measured at 56 GHz. The transmitter shows an eye with an RLM of 0.999. The transceiver can compensate for up to 43.9-dB insertion loss (IL) channel at 112 Gb/s. It consumes 690-mW per receiver (RX)/transmitter (TX). It is fabricated in 7-nm FinFET technology and occupies 0.63-mm2 per RX/TX.},
  keywords={Decision feedback equalizers;Clocks;Receivers;Transceivers;Equalizers;Transmitters;Pulse shaping methods;1 + D pulse shaping;112G;7-bit digital to analog converter (DAC);backplane;data center;decision feedback equalizer (DFE);feed-forward equalizer (FFE);forward error correction (FEC);look ahead;NRZ;PAM4;quarter-rate topology;serial link transceiver;source-series terminated (SST) driver},
  doi={10.1109/JSSC.2023.3313524},
  ISSN={1558-173X},
  month={Jan},}@INPROCEEDINGS{10811094,
  author={Katz, Gilad and Zlotsky, Stiven and Vinitzky, Ido and Babecovand, Alon and Wolftson, Benjamin and Sonkin, Eduard},
  booktitle={2024 Asian Conference on Communication and Networks (ASIANComNet)}, 
  title={Inclusive Performance Analysis of 100 Gbps PAM-4 at SerDes Using Digital Equalizers}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={In recent years, we have witnessed an increase in data transfer rates, which requires the development of new communication methods that can handle high-speed data transfer at challenging communication channels. One of the needs is the transmission of communication over serializer deserializer (SerDes) printed circuit boards (PCBs). which are used to transmit data between chips at high speeds of 10 Gbps and above, using the pulse amplitude modulation with four levels (PAM-4) encoding method, which enables lower losses and relatively low cost. Significant signal degradation is present in high-speed communication systems at SerDes, and inter-symbol interference (ISI) distortion dominates. One of the most effective methods to mitigate ISI distortion is the use of equalizers. The goal of this research is to study the performance of communication between two chips (transmitter/receiver) over SerDes PCB at 100 Gbps using the PAM-4 encoding method with an integrated continuous time linear equalizer (CTLE), feedforward equalizer (FFE), and decision feedback equalizer (DFE). The analysis includes a transmitter/receiver with PAM-4 encoding including the PCB channel response. Further, testing the performance of the combination of different equalizers while defining relevant values and parameters (rate, transmission, convergence rate, and equalizer coefficients). Performance are evaluated using signal-to-noise ratio (SNR) and bit error rate (BER) metrics. We investigated the BER performance for five PCBs of different lengths with analog CTLE and digital FFE-DFE equalizers and found that: For a small number of taps in FFE-DFE, a specific CTLE configuration is optimal, but for an optimal combination of FFEDFE, a different configuration of the CTLE is the best for all PCB lengths. We also show that the longer the PCB length, the more coefficients of the FFE-DFE are needed, consequently, more power is required to compensate for a longer PCB length. The components of your paper [title, text, heads, etc.] are already defined in its style sheet. *CAUTION: Do Not Use Symbols, Special Characters, Footnotes, or Math in Paper Title or Abstract. (Abstract)},
  keywords={Printed circuits;Bit error rate;Symbols;Distortion;Data transfer;Propagation losses;Encoding;Decision feedback equalizers;Signal to noise ratio;Testing;SerDes;PAM-4;Equalization;CTLE;PCB;DSP},
  doi={10.1109/ASIANComNet63184.2024.10811094},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11346689,
  author={Raghuram, Raj and Zheng, Ji and Su, Tao},
  booktitle={2025 IEEE 34th Conference on Electrical Performance of Electronic Packaging and Systems (EPEPS)}, 
  title={SPICE Based Optimization of Equalization in Channel Simulation}, 
  year={2025},
  volume={},
  number={},
  pages={1-3},
  abstract={For high speed applications such as SerDes [1], equalization techniques are used extensively to improve the eye diagram and Bit Error Rate. Common equalization techniques used are FFE (Feed Forward Equalization), CTLE (Continuous Time Linear Equalization), and DFE (Decision Feedback Equalization). The choice of equalization parameters depends on the channel. This paper provides a SPICE based methodology for optimizing the parameters for FFE, CTLE, and DFE for a given channel. The pulse response, obtained from SPICE, is used. As it is SPICE based, almost any circuit element can be handled.},
  keywords={Bit error rate;Linear circuits;SPICE;Decision feedback equalizers;Scattering parameters;Feeds;Signal integrity;Optimization;Electronics packaging;Signal Integrity;Equalization;Stateye;SerDes;SPICE;DFE;FFE;CTLE},
  doi={10.1109/EPEPS63858.2025.11346689},
  ISSN={2165-4115},
  month={Oct},}@ARTICLE{10756610,
  author={Khairi, Ahmad and Laufer, Amir and Radashkevich, Ilia and Krupnik, Yoel and Kim, Jihwan and Warshavsky Grafi, Tali and Balankutty, Ajay and Sabag, Yaniv and Segal, Yoav and Virobnik, Udi and Peng Li, Mike and Levin, Itamar and Ben Ezra, Yosef and Cohen, Ariel},
  journal={IEEE Open Journal of the Solid-State Circuits Society}, 
  title={Beyond 200-Gb/s PAM4 ADC and DAC-Based Transceiver for Wireline and Linear Optics Applications}, 
  year={2024},
  volume={4},
  number={},
  pages={265-276},
  abstract={System considerations, circuit architecture, and design implementation of wireline and linear optics transceivers capable of supporting data-rates beyond 200 Gb/s are presented. We showcase the silicon results of a transceiver designed in the advanced 3-nm CMOS process, which supports long-reach channels with up to 40 dB of loss at Nyquist. These results demonstrate the technology’s benefits of doubling the data rate of transceivers while achieving efficiency gains in power consumption and silicon area. This article highlights several key circuits architecture, such as hybrid continuous-time linear equalizer, inductive peaking clock routing, and one stage TX driver based on grounded switches. The proof-of-concept demonstration of 224 Gb/s with linear optics opens the avenue for power-efficient, low-latency future optical communication. This is crucial for high-performance computing (HPC) networking as well as emerging applications in high-end FPGA.},
  keywords={Signal to noise ratio;Transceivers;Symbols;Insertion loss;Optics;Bandwidth;Topology;Bit error rate;Decision feedback equalizers;Feedforward systems;Electro-optic devices;Pulse width modulation;Interleaved codes;Field programmable gate arrays;CMOS process;224 Gb/s;3 nm;digital DFE PLL;digital feed-forward equalizer (FFE);direct drive linear optics;electro-optics;PAM4;pulse amplitude modulation (PAM);SAR;SerDes;time-interleaved ADC;transmitter (TX)},
  doi={10.1109/OJSSCS.2024.3501975},
  ISSN={2644-1349},
  month={},}@INPROCEEDINGS{9620501,
  author={Wu, Miaomiao and Pang, Zhengbin and Lv, Fangxu and Shi, Jianjun and Wang, Heming and Liu, Tao and Lu, Dechao and Wang, Zheng},
  booktitle={2021 IEEE 14th International Conference on ASIC (ASICON)}, 
  title={An Adaptive Equalization Algorithm for High Speed SerDes}, 
  year={2021},
  volume={},
  number={},
  pages={1-4},
  abstract={This paper proposes a cooperative least mean square adaptive equalization algorithm for high-speed SerDes. To solve the problems of poor transmission signal quality and high bit error rate at high data rate, forward feedback equalizer (FFE) is used at the transmitter for pre-emphasis, continuous time linear equalizer (CTLE) is used at the receiver for analog equalization to compensate the high frequency loss of the channel, and then FFE and decision feedback equalizer (DFE) are used for digital equalization. To solve the complex adjustment of fixed tap equalizer coefficient and the problem that traditional adaptive equalization algorithm needs additional ideal signal or training sequence, adaptive equalization is adopted, and the decision value of DFE is directly used as the ideal signal for adaptive iteration. Simulation results show that the algorithm can make the eye diagram open to 75% of the senders, and the convergence time is less than 60 ns.},
  keywords={Training;Transmitters;Simulation;Conferences;Receivers;Adaptive equalizers;Propagation losses},
  doi={10.1109/ASICON52560.2021.9620501},
  ISSN={2162-755X},
  month={Oct},}@INPROCEEDINGS{9660321,
  author={Wu, Miaomiao and Lai, Mingche and Lv, Fangxu and Shi, Jianjun and Wang, Heming and Wang, Zheng and Tang, Zixiang and Xu, Chaolong},
  booktitle={2021 6th International Conference on Integrated Circuits and Microsystems (ICICM)}, 
  title={An Adaptive Equalizer for 56 Gb/s PAM4 SerDes}, 
  year={2021},
  volume={},
  number={},
  pages={398-402},
  abstract={Aiming at the problems of high bit error rate and large channel high-frequency loss in high-speed transmission, an adaptive equalizer suitable for 56 Gb/s PAM4 SerDes is designed. In order to improve the signal transmission bandwidth, PAM4 signal is used instead of NRZ signal. In order to improve the equalization effect, 4-tap FFE is used for pre-emphasis at the transmitter, and a two-stage CTLE is used for coarse equalization at the receiver. Furthermore, digital based 16-tap adaptive FFE and 1-tap adaptive DFE are used at the receiver to further reduce the bit error rate. Simulation results show that the equalizer can work at the rate of 56 Gb/s, and the eye diagram of PAM4 signal is obviously open. Compared with the traditional adaptive equalizer, it can effectively reduce the convergence time and bit error rate.},
  keywords={Transmitters;Bit error rate;Receivers;Bandwidth;Adaptive equalizers;Propagation losses;Decision feedback equalizers;channel attenuation;adaptive equalizer;least mean square algorithm;bit error rate},
  doi={10.1109/ICICM54364.2021.9660321},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{9988673,
  author={Wang, Zheng and Lv, Fangxu and Wang, Heming and Lu, Dechao},
  booktitle={2022 IEEE 2nd International Conference on Data Science and Computer Application (ICDSCA)}, 
  title={Adaptive Equalizer for 112 Gb/s DB-PAM4 SerDes}, 
  year={2022},
  volume={},
  number={},
  pages={1231-1235},
  abstract={In order to further improve the signal transmission efficiency, this paper designs a 112Gbps DB-PAM4 adaptive equalizer applied to the backplane channel. Aiming at the problem of complex generation of traditional DB-PAM4 signals and high equalization strength, this article adopts a new generation method of DB-PAM4 based on the backplane channel. Aiming at the problems of complicated adjustment of traditional equalization algorithms and slow tap convergence speed, In this paper, a joint adaptive equalization algorithm is used to adjust the degradation resistance of CTLE and the tap coefficients of FFE and DFE. This algorithm can take advantage of the advantages of different equalizers to make the tap coefficients fast and stable. Finally, the algorithm was verified by behavioral-level simulation in MATLAB. The results show that adaptive equalization of the channel can produce a better duo-binary effect. At a data rate of 112Gbps, the channel attenuation reaches -35dB, and the tap coefficients of FFE and DFE are Stable within 27ns, and the remaining error is less than 0.03V.},
  keywords={Training;Resistance;Degradation;Power demand;Backplanes;Simulation;Adaptive equalizers;The DB-PAM4 signal;Adaptive equalization;Double binary generation},
  doi={10.1109/ICDSCA56264.2022.9988673},
  ISSN={},
  month={Oct},}
