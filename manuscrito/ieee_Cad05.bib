  booktitle={2016 IEEE MTT-S Latin America Microwave Conference (LAMC)}, 
  title={Eye diagram optimization based on design of experiments (DoE) to accelerate industrial testing of high speed links}, 
  year={2016},
  volume={},
  number={},
  pages={1-3},
  abstract={Higher data rates in high speed input/output (HSIO) links demand more equalization (EQ) complexity, leading to an ever larger number of possible combinations of EQ settings. Finding the optimal set of EQ parameters through exhaustive methods is prohibitive given the time-to-market requirements. This paper presents a methodology to design a statistically sufficient set of experiments for optimizing the receiver eye diagram of a HSIO link while greatly reducing the overall testing time. Our methodology is illustrated by a 5-Gbps HSIO link comprised of a Tx, a channel (including packages, vias, PCB traces, connectors and a crosstalk aggressor) and an Rx.},
  keywords={Optimization;Receivers;Crosstalk;Jitter;Charge coupled devices;Connectors;Integrated circuit interconnections;central composite design;DoE;equalization;high speed I/O;optimization;response surface model},
