@INPROCEEDINGS{10370948,
  author={K, Aravinda},
  booktitle={2023 First International Conference on Advances in Electrical, Electronics and Computational Intelligence (ICAEECI)}, 
  title={Enhancing Signal Integrity in High-Speed Communication Systems Through Adaptive Equalization Techniques}, 
  year={2023},
  volume={},
  number={},
  pages={1-5},
  abstract={Signal integrity is a critical aspect in high-speed communication systems as it directly influences the quality and reliability of data transmission. This research paper focuses on enhancing signal integrity in high-speed communication systems through the application of adaptive equalization techniques. The study investigates the effectiveness of various adaptive equalization algorithms, such as Recursive Least Squares (RLS), Least Mean Squares (LMS), and Constant Modulus Algorithm (CMA), in compensating for channel impairments and reducing inter-symbol interference (ISI). The research explores the impact of different channel conditions, such as frequency-dependent attenuation and multipath propagation, on signal degradation. Experimental evaluations and simulations will be conducted to analyze the performance of the adaptive equalization techniques in terms of error rate, bit error rate (BER), and eye diagram quality. The results of this research will contribute to the development of advanced equalization methods for high-speed communication systems, enabling improved signal integrity, higher data rates, and reliable transmission in various applications, including wired and wireless communication, optical communication, and high-speed digital interfaces.},
  keywords={Adaptive systems;Communication systems;Bit error rate;Channel estimation;Interference;Adaptive equalizers;Decision feedback equalizers;Signal integrity;high-speed communication systems;adaptive equalization;Recursive Least Squares (RLS);Least Mean Squares (LMS);Constant Modulus Algorithm (CMA);inter-symbol interference (ISI)},
  doi={10.1109/ICAEECI58247.2023.10370948},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10705630,
  author={Lee, Seonghi and Kim, Hyunwoong and Ryu, Seunghun and Kim, Jiseong and Woo, Seongho and Ahn, Seungyoung},
  booktitle={2024 IEEE International Symposium on Electromagnetic Compatibility, Signal & Power Integrity (EMC+SIPI)}, 
  title={Linear Equalizer Effect-included Worst Eye Diagram Estimation Method for PCIe 6.0}, 
  year={2024},
  volume={},
  number={},
  pages={398-403},
  abstract={In this paper, linear equalizer effect-included eye estimation method was proposed for Peripheral component interconnect express (PCIe) Gen 6. To reflect the equalizer effect, the overall transfer function was calculated by combining the transfer function of the channel and the equalizer. The worst eye contour was predicted using the pulse amplitude modulation-4 (PAM-4) peak distortion analysis (PDA) method. For the verification, the feed forward equalizer (FFE) and continuous time linear equalizer (CTLE) were used. For channels, 9 channel cases with different loss values were assumed. The proposed method was compared with circuit simulation by eye diagram results and simulation time. The proposed method predicted the worst contours well, including the linear equalizer effect, and significantly reduced the simulation time, down to 93% faster, which is approximately 0.86 seconds.},
  keywords={Equalizers;Shape;Circuit simulation;Transfer functions;Estimation;Integrated circuit interconnections;Distortion;Feeds;Optimization;Next generation networking;High-speed serial link;Inter-symbol Interference(ISI);Linear equalizer;Peak distortion analysis (PDA);Pulse-amplitude modulation-4 (PAM-4)},
  doi={10.1109/EMCSIPI49824.2024.10705630},
  ISSN={2158-1118},
  month={Aug},}@INPROCEEDINGS{11014370,
  author={Lee, Seonghi and Woo, Seongho and Ryu, Seunghun and Lee, Sanguk and Kim, Hyunwoo and Lee, Jinwook and Kim, Dongkyun and Kim, Jiseong and Ahn, Seungyoung},
  booktitle={2025 IEEE 29th Workshop on Signal and Power Integrity (SPI)}, 
  title={A Novel Termination Resistance-Controlled Passive Equalization Method for Signal Integrity Enhancement in High-Speed Channel}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={In this paper, we propose a novel termination resistance-controlled passive equalization method for signal integrity (SI) enhancement in high-speed channel. The proposed approach combines a termination resistance control method with a passive equalizer (PEQ) to mitigate inter-symbol interference (ISI) and DC-level reduction. By boosting the receiver (RX) voltage, pre-emphasis and DC-level boosting are achieved, while the PEQ cancels ISI. To validate the proposed method, the eye diagram performance of a structure without a PEQ, the conventional PEQ, and the proposed method were compared in both non-return to zero (NRZ) and pulse amplitude modulation (PAM)-4 scenarios. The proposed method demonstrates better performance than the conventional PEQ and is more effective in PAM-4 scenarios.},
  keywords={Resistance;Equalizers;Simulation;Interference;Receivers;Boosting;Amplitude modulation;Optical signal processing;Signal integrity;Faces;Inter-symbol interference (ISI);pulse amplitude modulation (PAM)-4;passive equalizer},
  doi={10.1109/SPI64682.2025.11014370},
  ISSN={2835-0898},
  month={May},}@INPROCEEDINGS{9449285,
  author={Zhao, QinYuan and Bu, XiangYuan and Song, Zhe and Fang, JinHui and Wang, Shuai},
  booktitle={2021 IEEE 6th International Conference on Computer and Communication Systems (ICCCS)}, 
  title={Real Time Noise Power Estimation for Single Carrier Frequency Domain Equalization}, 
  year={2021},
  volume={},
  number={},
  pages={651-655},
  abstract={Wireless broadband high-speed data transmission technology is one of the key technologies used to realize mutual communication between various unmanned vehicles, unmanned ships and unmanned aerial vehicles in the future civil and military fields. Since data transfer rate is continuously increasing and the multipath effect of the near-earth channel brings frequency selective fading, the receiver usually uses an adaptive equalizer to eliminate inter-symbol interference (ISI). Instead of the time-domain-equalization methods commonly used in current engineering implementations, in this article, we use the frequency-domain MMSE equalization algorithm to give a realtime accurate estimation method for the “noise power” coefficient in the equalizer parameters during engineering implementation. In this article, we will explain the system design and demodulation methods required for real-time noise estimation based on frequency-domain MMSE equalization, and discuss the performance advantages over time domain equalization without increasing the complexity of the algorithm. It is demonstrated that it can be better applied to high-speed data communication under multipath fading channels. The algorithm is verified through computer simulation and field measurement.},
  keywords={Fading channels;Wireless communication;Frequency-domain analysis;Estimation;Channel estimation;Real-time systems;Unmanned aerial vehicles;high-speed broadband data link;frequency domain equalization;MMSE algorithm;noise estimate},
  doi={10.1109/ICCCS52626.2021.9449285},
  ISSN={},
  month={April},}@INPROCEEDINGS{10873709,
  author={Mkhitaryan, Artur and Hakobyan, Lyudvig and Gevorgyan, Albert},
  booktitle={2024 IEEE East-West Design & Test Symposium (EWDTS)}, 
  title={High-Speed Continuous Time Linear Equalizer for Multi-Purpose SerDes Applications}, 
  year={2024},
  volume={},
  number={},
  pages={1-5},
  abstract={The integration of versatile Continuous Time Linear Equalizers has emerged as a very critical technology to help in enhancing the quality of the signal and system performance in modern high-speed communication links. With the demand for high data rates CTLEs will play a key role in mitigating inter-symbol interference and become crucial for channel loss compensation in densely packed multi-gigabit systems. This paper reviews some of the basic operation principles of CTLE, including the inductor-bypass and peak-control techniques proposed, underlying versatility from various points of view. A part of the work deals with the investigation of the challenges imposed by transmission media and explains in detail how advanced CTLE designs can be used for their compensation by means of dynamic response adjustments and precision control of frequency characteristics. Further, the paper suggests incorporating inductor-bypass and peak-control techniques into the traditional CTLE architecture. The implementation of the inductor-bypass technique within the CTLE design leads to a significantly enhanced performance that allows operation at low loss for small channel sizes. By enabling it, the peak gain of the CTLE drops by 5db. To support lower data rates, the peak-control technique was later introduced in the paper. This option appropriately equalizes the lower Nyquist frequencies and extends the range of frequency support into a variable spectrum between 10 and 28GHz with no significant negative impacts in operational efficiency and power dissipation.},
  keywords={Dynamic response;Time-frequency analysis;Equalizers;Reviews;System performance;Interference;Media;Power dissipation;Frequency control;CTLE;channel;ISI;Nyquist frequency},
  doi={10.1109/EWDTS63723.2024.10873709},
  ISSN={2472-761X},
  month={Nov},}@INPROCEEDINGS{10011261,
  author={Zhang, Kun},
  booktitle={2022 7th International Conference on Integrated Circuits and Microsystems (ICICM)}, 
  title={A 4 Gb/s Adaptive CTLE Based on Data Edge Counting and 8B10B Coding for DisplayPort}, 
  year={2022},
  volume={},
  number={},
  pages={453-458},
  abstract={This paper proposes a 4 Gb/s adaptive continuous-time linear equalizer (CTLE) based on data edge counting and 8Bl0B coding for DisplayPort to compensate channel loss and inter-symbol interference (ISI) resulting from limited channel bandwidth. 8Bl0B coding used in DisplayPort guarantees that serialized 8Bl0B encoded data stream has a high transition density between 0 and 1 for clock data recovery and DC-balancing. Taking advantage of this characteristic of 8Bl0B coding, the proposed adaptive CTLE quickly adjusts its peaking gain by counting rising data edges to achieve optimal equalization for a transmission channel with 13-dB loss used in DisplayPort. The proposed adaptive scheme is mainly composed of a programmable CTLE using a negative capacitance circuit, a pipelined 8Bl0B encoder, a pipelined 8Bl0B decoder, a data edge counter and an adaptation controller. The proposed circuit has been designed with a 180 nm CMOS process as part of a DisplayPort transceiver. Simulation results show that the proposed CTLE achieves adaptation in 4 $\mu$s and consumes 10.8 mW from a 1. SV supply.},
  keywords={Micromechanical devices;Integrated circuits;Power demand;Simulation;Bandwidth;Interference;CMOS process;adaptive CTLE;8B10B coding;ISI;high speed transceiver;DisplayPort},
  doi={10.1109/ICICM56102.2022.10011261},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11244456,
  author={Yerragudi, Shameer Basha and Pramod, Ashwin P and Yachareni, Santosh and Le, Khanh M and Abbas, Zia},
  booktitle={2025 IEEE 68th International Midwest Symposium on Circuits and Systems (MWSCAS)}, 
  title={A 16-Gb/s CTLE with Active Inductor Load and Feed-Forward Architecture in 28-nm CMOS for High-Speed Serial Links}, 
  year={2025},
  volume={},
  number={},
  pages={94-97},
  abstract={A 16-Gb/s continuous-time linear equalizer (CTLE) is designed in 28-nm CMOS technology, featuring an active inductor load and feedforward compensation to enhance high-frequency performance. The proposed design features a power-efficient architecture, achieving a remarkable eye opening of 45.75 ps and a vertical differential eye opening of 781.19 mV. The design achieves reliable operation for channel losses of 9 dB, consuming a total power of 3.3 mW from a 0.9 V supply. This CTLE provides an energy-efficient solution for high-speed SerDes applications, with a calculated figure-of-merit of 0.022 pJ/hit/dB.},
  keywords={Time-frequency analysis;Active inductors;Power demand;Equalizers;Bit error rate;Interference;Reliability engineering;Propagation losses;Silicon;Optical signal processing;Continuous time linear equalizer (CTLE);feed-forward system;active inductor;non-return-to-zero (NRZ);inter-symbol interference (ISI);bit error rates (BER)},
  doi={10.1109/MWSCAS53549.2025.11244456},
  ISSN={1558-3899},
  month={Aug},}@ARTICLE{9737025,
  author={Borah, Dubari and Gupta, Aarushi and Kalkur, Thottam S. and Miller, Ken},
  journal={IEEE Transactions on Components, Packaging and Manufacturing Technology}, 
  title={A 5-Gb/s Adaptive Continuous Time Linear Equalizer Using Ferroelectric Capacitor}, 
  year={2022},
  volume={12},
  number={4},
  pages={647-654},
  abstract={This article presents a 5-Gb/s continuous-time linear equalizer (CTLE) for serial link interface where adaptive nature is achieved using a ferroelectric capacitor. This barium strontium titanate (BST)-based STPTIC-15G2 capacitor model from STMicroelectronics provides a smooth 5:1 tuning range for a voltage range of 0–18 V and eliminates the use of blocking capacitor required in case of varactor diode. The tunability of the high-pass filter response of the proposed CTLE provides the flexibility to meet the allocated loss budget of any serial link more precisely than a design with a discrete value capacitor. Also, its design methodology is much simpler than conventional MOSFET-based CTLE. Moreover, it avoids the use of complex algorithms seen in the case of digital equalization. For validation, the design is implemented on an FR4 board. While studying the data rate tolerance and channel tolerance of the printed prototype, the measured results closely match the simulation results. The compensation level of the equalizer is verified for an FR4 channel by varying its length from  $7^{\prime \prime }$  to  $28^{\prime \prime }$  which is equivalent to a change in insertion loss from 1.3 to 5.2 dB at 2.5 GHz, which is the Nyquist frequency for a 5-Gb/s signal. Also, for a  $28^{\prime \prime }$  FR4 channel, a channel loss requirement of 8–9.5 dB is achievable by simply varying the applied bias to the ferroelectric capacitor from 0 to 10 V.},
  keywords={Capacitors;Equalizers;Jitter;Insertion loss;Adaptive equalizers;Tuning;Packaging;Adaptive equalizer;barium strontium titanate (BST);continuous-time linear equalizer (CTLE);ferroelectric capacitor;serial link},
  doi={10.1109/TCPMT.2022.3158933},
  ISSN={2156-3985},
  month={April},}@INPROCEEDINGS{9660321,
  author={Wu, Miaomiao and Lai, Mingche and Lv, Fangxu and Shi, Jianjun and Wang, Heming and Wang, Zheng and Tang, Zixiang and Xu, Chaolong},
  booktitle={2021 6th International Conference on Integrated Circuits and Microsystems (ICICM)}, 
  title={An Adaptive Equalizer for 56 Gb/s PAM4 SerDes}, 
  year={2021},
  volume={},
  number={},
  pages={398-402},
  abstract={Aiming at the problems of high bit error rate and large channel high-frequency loss in high-speed transmission, an adaptive equalizer suitable for 56 Gb/s PAM4 SerDes is designed. In order to improve the signal transmission bandwidth, PAM4 signal is used instead of NRZ signal. In order to improve the equalization effect, 4-tap FFE is used for pre-emphasis at the transmitter, and a two-stage CTLE is used for coarse equalization at the receiver. Furthermore, digital based 16-tap adaptive FFE and 1-tap adaptive DFE are used at the receiver to further reduce the bit error rate. Simulation results show that the equalizer can work at the rate of 56 Gb/s, and the eye diagram of PAM4 signal is obviously open. Compared with the traditional adaptive equalizer, it can effectively reduce the convergence time and bit error rate.},
  keywords={Transmitters;Bit error rate;Receivers;Bandwidth;Adaptive equalizers;Propagation losses;Decision feedback equalizers;channel attenuation;adaptive equalizer;least mean square algorithm;bit error rate},
  doi={10.1109/ICICM54364.2021.9660321},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11342471,
  author={Sung, Guo-Ming and Kohale, Sachin D. and Chang, Shu-Wen and Tung, Li-Fen and Tseng, Chwan-Lu and Chou, Jen-Hsiang},
  booktitle={2025 IEEE International Conference on Systems, Man, and Cybernetics (SMC)}, 
  title={Adaptive Decision Feedback Equalization for High-Speed Serializer/Deserializer Communication System}, 
  year={2025},
  volume={},
  number={},
  pages={3753-3758},
  abstract={An 8-tap feed-forward equalizer (FFE) and 10-tap decision feedback equalizer (DFE) were designed for the IEEE 802.3u 100Base-TX specification. The weights of these adaptive filters are updated with a sign–sign least-mean-square (SSLMS) algorithm. To ensure the flexibility of the circuits for various environments channel lengths, the equalizers are designed such that the number of taps can be adjusted to between 1 and 8 for the FFE and 1 and 10 for the DFE. Results indicated that the equalizer can compensate for channel delays of more than 20 dB, and it achieved a bit error rate of 2 × 10−3. Both FFE and DFE not only mitigate signal distortion but also significantly eliminate inter-symbol interference (ISI) in high-speed serializer/deserializer (SerDes) communication systems. The application-specific integrated circuit (ASIC) was designed using Verilog Hardware Description Language (HDL) and implemented with the TSMC 90-nm CMOS 1P9M standard cell process. In simulations, the chip area, delay cycle, and logic gate counts were 845.445 × 845.445 μm2, 12 cycles, and 75 187 gates, respectively. The supplied voltage and frequency of the proposed adaptive DFE were 1.2 V and 250 MHz, respectively.},
  keywords={Communication systems;Circuits;Intersymbol interference;Adaptive filters;Logic gates;Filtering algorithms;Decision feedback equalizers;Delays;Hardware design languages;Integrated circuit modeling},
  doi={10.1109/SMC58881.2025.11342471},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10457088,
  author={Choi, Yujin and Jang, Seoyoung and Kim, Gain},
  booktitle={2024 International Conference on Electronics, Information, and Communication (ICEIC)}, 
  title={Area Optimization of the Feed-Forward Equalizer for ADC-Based High-Speed Wireline Receiver Using Channel Characteristics}, 
  year={2024},
  volume={},
  number={},
  pages={1-3},
  abstract={In high-speed serial link, the analog-digital converter (ADC)-based receiver (RX) architecture has been widely applied with 4-level pulse amplitude modulation (PAM-4) for> 56 Gb/s/lane. While ADC-based RXs exhibit strong equalization capability, the feed-forward equalizer (FFE) in its digital signal processor (DSP) occupies a large area due to the large number of multipliers required to implement the parallel finite impulse response (FIR) filter. In this work, we explore the required number of bits for the FFE coefficients depending on the tap position given a chip-to-chip channel profile. By proper bit-level optimization of the FFE multipliers, 42 % of the FFE area could be saved for the twelve largest FFE tap values as compared to the case where the same-sized FFE multipliers are considered for a channel exhibiting 28 dB of loss at 28 GHz.},
  keywords={Equalizers;Finite impulse response filters;Simulation;Digital signal processors;Receivers;Minimization;Amplitude modulation;Serial link;SerDes;wireline receiver;PAM-4;feed-forward equalizer;ADC-based receiver},
  doi={10.1109/ICEIC61013.2024.10457088},
  ISSN={2767-7699},
  month={Jan},}@ARTICLE{11541177,
  author={Lee, Seonghi and Lee, Sanguk and Ryu, Seunghun and Kim, Hyunwoo and Woo, Seongho and Lee, Jinwook and Kim, Jiseong and Ahn, Seungyoung},
  journal={IEEE Transactions on Components, Packaging and Manufacturing Technology}, 
  title={Design of Termination Resistance-Adjusted Passive Equalizer for Low-Power and High-Speed Signaling}, 
  year={2026},
  volume={},
  number={},
  pages={1-1},
  abstract={In this paper, a termination-resistance-adjusted passive equalization method is proposed to improve the signal-integrity performance while reducing power consumption. By increasing the receiver termination resistance, the proposed structure provides an inherent pre-emphasis effect at the receiver, while the resulting reflection components are structurally exploited to achieve de-emphasis and inter-symbol interference (ISI) mitigation. To analyze and design the proposed structure, a lattice-diagram-based reflection analysis and a state-transition function–based time-domain model are introduced. The proposed model enables separation of the channel response and the passive equalizer response, allowing efficient single-bit response computation and rapid design optimization by means of a PAM-4 peak distortion analysis (PDA). The effectiveness of the proposed method is validated through simulations and measurements in a 32-Gbps single-ended PAM-4 signaling environment. Experimental results show that the proposed passive equalizer achieves a larger eye opening than conventional passive and active equalizers under the same supply voltage while consuming the lowest amount of power among all tested equalizers. Moreover, under identical eye-height conditions, the proposed structure enables up to 39.3% power reduction by operating at a lower supply voltage, demonstrating its suitability for power-efficient high-speed interfaces.},
  keywords={Equalizers;Design methodology;Voltage;Eyes;Modeling;Power demand;Reflection;Timing;Signal integrity;Resistance;Inter-symbol interference (ISI);pulse amplitude modulation (PAM)-4;passive equalizer;signal integrity (SI);pulse amplitude modulation (PAM)-4;peak distortion analysis (PDA)},
  doi={10.1109/TCPMT.2026.3698448},
  ISSN={2156-3985},
  month={},}@INPROCEEDINGS{11169790,
  author={Lee, Seonghi and Lee, Sanguk and Ryu, Seunghun and Park, Dongryul and Kim, Hyunwoo and Lee, Yongho and Park, Jiyoung and Nam, Seungki and Moon, Sungwook and Kim, Jiseong and Ahn, Seungyoung},
  booktitle={2025 IEEE International Symposium on Electromagnetic Compatibility, Signal & Power Integrity (EMC+SIPI)}, 
  title={Signal Integrity Analysis-Based Channel and Equalizer Co-Design Methodology for High-Speed Serial Links}, 
  year={2025},
  volume={},
  number={},
  pages={488-493},
  abstract={In this paper, we propose a signal integrity (SI)-based channel and equalizer co-design methodology for efficient design in high-speed serial links. The proposed approach defines SI metrics to evaluate the characteristics of channels and performs correlation analysis to derive design guidelines. By leveraging these guidelines, the proposed method enables the efficient selection of channel and equalizer parameters, strategically narrowing the design search space for problems with extensive design spaces. To validate the proposed method, pulse amplitude modulation (PAM)-4 eye diagram results and turnaround time (TAT) were compared with genetic algorithm (GA) across four different scenarios. The results demonstrate that the proposed method achieves designs with comparable or superior performance to GA while significantly reducing TAT.},
  keywords={Measurement;Correlation;Equalizers;Design methodology;Search problems;Amplitude modulation;Signal integrity;Genetic algorithms;Guidelines;Co-design methodology;Serializer/de-serializer (SerDes);signal integrity (SI);peripheral component interconnect express (PCIe)},
  doi={10.1109/EMCSIPI52291.2025.11169790},
  ISSN={2158-1118},
  month={Aug},}@ARTICLE{11009014,
  author={Kim, Hanseok and Lee, Sihyun and Jeong, Piljun and Kim, Jaeha and Choi, Woo-Seok},
  journal={IEEE Access}, 
  title={Implementing FFE-MLSD With Improved BER and Reduced Complexity for Long-Reach PAM4 Wireline Receivers}, 
  year={2025},
  volume={13},
  number={},
  pages={90726-90740},
  abstract={This paper proposes a PAM4 receiver DSP architecture based on Feed-Forward Equalizer (FFE) and Maximum Likelihood Sequence Detector (MLSD), targeting improved bit-error-rate (BER) performance and reduced hardware complexity. Two key contributions are presented: (1) an FFE tap coefficient optimization framework that tunes the FFE to provide the output with an inter-symbol interference (ISI) memory length of two for better MLSD performance, and (2) a Top-K selection technique that reduces the computational complexity of MLSD by limiting the number of branch metric computations per trellis stage. The coefficient training is performed in two stages using least-mean-square (LMS) and cross-entropy loss based on pseudo-labels derived from MLSD outputs. Simulation results show two orders of magnitude improvement in BER over conventional LMS-based FFE coefficient optimization. In addition, to mitigate the MLSD complexity, Top-K selection approach is proposed to select only the most relevant K branches for MLSD computation using a pre-computed lookup table. The proposed architecture is synthesized and evaluated in a 28nm CMOS process and also implemented on the RealDigital RFSoC $4\times 2$  FPGA board for demonstration. Compared to the full-metric MLSD architecture, the proposed reduced-complexity MLSD achieves 74% reduction in area and 65% in power consumption while maintaining BER performance.},
  keywords={Receivers;Computer architecture;Measurement;Decision feedback equalizers;Training;Noise;Symbols;Power demand;Hardware;Digital signal processing;ADC-based receiver;digital signal processing (DSP);feed-forward equalizer (FFE);high-speed serial link;long-reach channel;maximum likelihood sequence detector (MLSD);PAM4;Viterbi algorithm;wireline communication},
  doi={10.1109/ACCESS.2025.3572568},
  ISSN={2169-3536},
  month={},}
